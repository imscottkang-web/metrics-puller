# Copy to a house's own folder as `.env` (gitignored there) - never commit real values.
# This tool is shared by more than one YouTube channel; every setting below belongs to
# one house's own .env, never to this repo's own folder. See README.md.

# Required: where this house's snapshot CSV, retention curves, reach-report archive,
# and published-video list get written. Relative paths resolve against this house's
# own folder; an absolute path is used as-is.
METRICS_DATA_DIR=data

# Required: this house's folder of video script folders (each with a bet_card.md).
METRICS_SCRIPTS_DIR=scripts

# Required: this house's own reach-report job name in the YouTube Reporting API, so
# it can be told apart from any other house's job in the Google API console.
METRICS_REACH_JOB_NAME=this-house-reach

# Optional: path to the downloaded OAuth "Desktop app" client secret JSON.
# If unset, the tool looks for secrets/client_secret.json inside this house's folder.
YT_OAUTH_CLIENT_SECRET=/absolute/path/to/client_secret_XXXX.apps.googleusercontent.com.json

# Optional: this house's YouTube channel id. Turns on the published-video list (when
# YOUTUBE_API_KEY is also set) and the channel-identity safety check. See README.md.
YT_CHANNEL_ID=

# Optional: a public YouTube Data API key, paired with YT_CHANNEL_ID above.
YOUTUBE_API_KEY=
